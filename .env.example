# Copy this file to .env and fill in the key for the provider you use.
# You only need ONE provider's key: whichever LLM_PROVIDER is selected below.

# ---- Active provider and model ----
# Supported providers: google_genai, openai, groq, anthropic
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-2.5-flash

# ---- Provider API keys (fill in only the one you use) ----
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
